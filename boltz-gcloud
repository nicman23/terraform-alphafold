#!/bin/bash

input=$1
output=boltz_outputs_${input}
[ ! -z $2 ] && template=$2 || template=rtx6k-boltz
cloud=gcloud
max_vms=20
name_prefix=$input-$template
file_weight=10
SESSION_MODE=1
if [ -z "$STY" ]; then
  echo must be run from a \(GNU\) screen
  exit
fi

source $(dirname $(realpath $0))/command_center_lib.sh

get_additional_files() {
  (
  cat
  ls *csv
  ls *a3m
  ) # | tee debug
}

send_work() {
  sssh rm -rf $output $input workdir work_done final_done &>/dev/null
  pv $work_zstd | sssh 'zstd -d | tar -xf -'

  cat << EOF | sssh cat - \> work.sh
  . venv/bin/activate
  pkill python -9
  touch /root/.boltz/mols.tar
  rm -rf $output workdir /root/work_done /root/final_done
  mkdir $output workdir

  for i in $input/*yaml; do
    mkdir -p /root/workdir/\$i
    [ -e /root/$output/\$i ] && continue

    if boltz predict \$i --out_dir /root/workdir/\$(basename \$i) --use_potentials --diffusion_samples 1; then
      mv /root/workdir/\$(basename \$i)/* /root/$output/\$(basename \$i)
      echo \$(basename \$i) >> work_done
    fi

  done
  touch /root/final_done
EOF
}

if ! ls $input | grep -m1 yaml &>/dev/null; then # bash arg limit
  echo $input empty
  exit 2
fi

mkdir -p $output
get_files() {
#  cnt=0
  ls $input $output | grep -v a3m | grep -v csv | grep yaml | sort | uniq -u |
    while read l; do
      [ -e $input/$l ] && echo $input/$l
#      cnt=$((cnt + 1))
    done
#  echo Found $cnt to be processed > /dev/stderr
}

if ! (ls *a3m || ls *csv) &>/dev/null; then
  echo the script expects the a3m files to be in the currect directory
fi


trap cleanup EXIT
trap cleanup ERR

#set -x
main_af
fancy

wait
