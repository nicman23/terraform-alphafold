#!/bin/bash

input=$1
output=gmx_outputs_${input}
template=rtx6k-gmx
cloud=gcloud
max_vms=30
name_prefix=$template
file_weight=1
fancy_ignore='.mdp'

SESSION_MODE=1
# base64 -d | unzstd
gmxAutopilot=''
if [ -z "$STY" ]; then
  echo must be run from a \(GNU\) screen
  exit
fi

source $(dirname $(realpath $0))/command_center_lib.sh

get_additional_files() {
  cat
  (
  find $input/*mdp gmxAutopilot.sh
  ) 2>/dev/null || true
}

send_work() {
  sssh rm -rf $output $input workdir work_done final_done &>/dev/null
  echo "$gmxAutopilot" | sssh 'base64 -d | zstd -d > gmxAutopilot.sh'
  pv $work_zstd | sssh 'zstd -d | tar -xf - ; chmod +x gmxAutopilot.sh'

  cat << EOF | sssh cat - \> work.sh
  export PYTHONPATH=/opt/amber/lib/python3.14/site-packages:/usr/lib/python3.14/site-packages
  source /opt/amber/amber.sh
  pkill gmx_mpi -9
  pkill python -9
  pkill python -9
  pkill gmxAutopilot.sh -9

  rm -rf $output workdir /root/work_done /root/final_done
  mkdir $output workdir
  echo find pdbs at $input/*pdb
  ls $input/*pdb || exit
  for i in $input/*pdb; do

    [ -e /root/$output/$input/\$i ] && continue

    mkdir -p /root/workdir/\$i /root/$output/$input/
    cp \$i $input/*mdp /root/workdir/\$i
    if ~/gmxAutopilot.sh /root/workdir/\$i; then
      mv /root/workdir/\$i /root/$output/
      echo \$( basename \$i ) >> work_done
    fi
  done
  touch /root/final_done
EOF
}
pwd
if ! ls $input/*pdb &>/dev/null; then
  echo \'$input\' empty
  exit 2
fi

mkdir -p $output
get_files() {
  ls $input $output | grep -v mdp | grep pdb | sort | uniq -u |
    while read l; do
      [ -e $input/$l ] && echo $input/$l
    done
}

if ! ls $input/*mdp  &>/dev/null; then
  echo the script expects the mdp files to be in the input \'$input\' directory
fi

created_vms=()
trap cleanup EXIT
trap cleanup ERR

echo refreshing state please wait
wait_for_lock
refresh_state
#set -x
main_af &
#set +x
fancy
echo done!!!!!!!!!!!!!!!!
read
wait
